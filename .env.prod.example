# Copy to .env.prod on the VPS and fill in. Never commit .env.prod.
# Generate each secret with:  openssl rand -hex 32
# (hex only: the Mongo password is embedded in a URL, so avoid @ : / ? # %)

MONGO_ROOT_USER=dixtrie_admin
MONGO_ROOT_PASSWORD=41e8a004c6e06d0db530c2bb3d63cee26bc99d91684ae01b713acec2c9f2d45c
MONGO_DB_NAME=multicompany_commerce

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

API_PREFIX=v1
OTP_CODE_TTL_SECONDS=300

# Browser origins allowed to call the API (comma-separated). localhost is always allowed.
CORS_ORIGINS=https://dixtriv2-one.vercel.app

# SMTP used to send OTP codes by email (required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dixtri <no-reply@dixtri.com>"

# File storage (S3-compatible / MinIO). Leave S3_ENDPOINT empty to keep uploads
# disabled. Use a dedicated bucket + an access key limited to that bucket.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=dixtri
# Folder inside the bucket — set it (e.g. dixtri) when the bucket is shared with another app.
S3_KEY_PREFIX=
S3_AUTO_CREATE_BUCKET=true
MAX_UPLOAD_BYTES=10485760
API_PUBLIC_URL=https://api-test.dixtri.com

S3_ENDPOINT=http://207.180.239.66:9900
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=dixtri-ecomm
S3_KEY_PREFIX=dixtri-ecomm
S3_AUTO_CREATE_BUCKET=false