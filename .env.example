# Server
PORT=3000
API_PREFIX=v1
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/multicompany_commerce

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# CORS: localhost (any port) is always allowed. Add other browser origins here, comma-separated.
CORS_ORIGINS=https://dixtriv2-one.vercel.app

# OTP by email. Without SMTP_HOST (local dev only) the code is fixed to
# OTP_DEV_STATIC_CODE and printed in the server console.
OTP_CODE_TTL_SECONDS=300
OTP_DEV_STATIC_CODE=123456
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dixtri <no-reply@dixtri.com>"
